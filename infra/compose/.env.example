# infra/compose/.env — credentials for the local docker-compose stack.
#
# `make infra-up` / `make infra-down` and CI copy this template to
# `infra/compose/.env` (which is gitignored — customize it freely). It is only
# read by docker-compose in this directory; nothing else loads it.
#
# ⚠️  THESE ARE INSECURE DEVELOPMENT DEFAULTS. The compose files here are for
#     local development only — never deploy them as-is. For a real deployment,
#     supply real secrets (via a secrets manager / orchestrator secrets) for
#     every variable below; the compose files use `${VAR:?}` so a service
#     refuses to start when its credential is missing.

# Postgres password — shared by the app services, Temporal, Keycloak (KC_DB_*)
# and OpenFGA. (The username/db name stay `urule` — not secrets.)
POSTGRES_PASSWORD=urule

# Keycloak admin console login (http://localhost:8281).
# Username + password both required — there is no `admin` default for either
# (Phase N change). Set both before booting the stack.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Grafana admin login (http://localhost:3030).
GRAFANA_ADMIN_PASSWORD=urule

# Default-deny additions (Phase N). Override only when you know why.
#
# `URULE_BIND_HOST` — every host port in the compose stack now binds to
# loopback only. Set to `0.0.0.0` to expose backends on the host's external
# interface (needed for remote demos; never do this on a public-internet
# host without TLS + an auth gate in front).
# URULE_BIND_HOST=127.0.0.1
#
# `GRAFANA_ANONYMOUS_VIEWER` — Grafana anonymous viewer used to default on;
# anyone reaching the Grafana port read every dashboard. Now off. Set to
# `true` for the convenience workflow.
# GRAFANA_ANONYMOUS_VIEWER=false
