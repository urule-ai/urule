{
  "name": "urule",
  "version": "0.1.0",
  "private": true,
  "description": "Urule — The open-source coordination layer for AI agents.",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "services/*",
    "plugins/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "build:all": "turbo run build",
    "test:all": "turbo run test",
    "lint:all": "turbo run lint",
    "typecheck:all": "turbo run typecheck",
    "docs:api": "typedoc --options typedoc.json",
    "docs:api:watch": "typedoc --options typedoc.json --watch",
    "clean": "rm -rf node_modules .turbo && npm run clean --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.9.7",
  "keywords": [
    "ai-agents",
    "ai-platform",
    "control-plane",
    "mcp",
    "model-context-protocol",
    "orchestration",
    "langgraph",
    "anthropic",
    "claude",
    "fastify",
    "typescript",
    "approval-workflow",
    "human-in-the-loop",
    "widget-sdk",
    "multi-agent",
    "nats",
    "openfga",
    "open-source"
  ],
  "homepage": "https://urule.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/urule-ai/urule.git"
  },
  "bugs": {
    "url": "https://github.com/urule-ai/urule/issues"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "turbo": "^2.3.0",
    "typedoc": "^0.27.0"
  }
}
