{
  "name": "@urule/correlation-id",
  "version": "0.1.0",
  "description": "Correlation ID propagation for Urule services — Fastify plugin + AsyncLocalStorage + fetch wrapper for end-to-end request tracing",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean:peers": "rimraf node_modules/fastify"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/urule-ai/urule.git",
    "directory": "packages/correlation-id"
  },
  "dependencies": {
    "fastify-plugin": "^5.0.0",
    "ulid": "^2.3.0"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fastify": "^5.0.0",
    "rimraf": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
